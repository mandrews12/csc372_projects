            <p>$15.00</p>
            <button class="view-details">View Details</button>
        </div>
        <div class="item" data-description="Stunning alcohol ink flower artwork on canvas." data-stock="In Stock">
            <img src="images/product_placeholder.png" alt="Alcohol Ink Flower" height="150">
            <h3>Alcohol Ink Flower</h3>
            <p>$30.00</p>
            <button class="view-details">View Details</button>
        </div>
        <div class="item" data-description="Alcohol ink flower designs on decorative tiles." data-stock="In Stock">
            <img src="images/product_placeholder.png" alt="Alcohol Ink Tile" height="150">
